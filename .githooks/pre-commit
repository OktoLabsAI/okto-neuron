#!/usr/bin/env bash
# .githooks/pre-commit — docs gate (commit-time)
#
# The live codebase is the source of truth; docs/ must mirror it.
# This enforces four commit-time checks:
#   1. Source changes under src/okto_neuron/ need an accompanying documentation
#      source update.
#   2. Documentation source changes need the generated docs HTML refreshed.
#   3. The durable registry, source/generated links, and focused semantic invariants
#      remain valid.
#   4. Changes to current agent instructions/workflows run the semantic checks too.
#
# Changed-path classification and version reads use the staged snapshot. The
# generator and pytest checks run against the working tree, so this hook refuses
# unstaged changes in every durable/instruction/production path those checks read.
# CI remains the authoritative check of the exact pushed SHA.
#
# Satisfy the check by staging the doc updates into the same commit (use
# /sync-docs to regenerate). The previous MARGINALIA_DOCS_GATE=off escape has
# been removed. Like every local hook, this can be skipped with --no-verify;
# GitHub Actions still reports the exact pushed SHA, and release work must wait
# for that run because branch protection is unavailable on the current plan.
#
# Activated per-clone via:  git config core.hooksPath .githooks

staged_paths=()
while IFS= read -r -d '' path; do
  staged_paths+=("$path")
done < <(git diff --cached --no-renames --name-only -z)
[ "${#staged_paths[@]}" -eq 0 ] && exit 0

path_is_docs_source() {
  case "$1" in
    README.md|RFC.md|frontend/README.md|packaging/README.md|\
    docs/understanding/index.html|docs/plans/*.md|docs/backends/*.md) return 0 ;;
    # bash case globs match "/", so exclude anything nested under a docs/
    # subdirectory (e.g. docs/benchmarks/*.md) before the top-level check below —
    # only files directly in docs/ are docs source. docs/plans/*.md and
    # docs/backends/*.md are explicit exceptions above: they are
    # THEMES-registered generator inputs (docs/build_knowledge_base.py), not
    # scratch subdirectory content.
    docs/*/*) return 1 ;;
    docs/*.md|docs/*.json|docs/*.py) return 0 ;;
  esac
  return 1
}

path_is_generated_doc() {
  case "$1" in
    docs/index.html|docs/knowledge-base/index.html|docs/rfc.html|docs/roadmap.html) return 0 ;;
  esac
  return 1
}

path_is_instruction_source() {
  case "$1" in
    frontend/src/*|.github/workflows/*.yml|\
    .github/workflows/*.yaml|.githooks/*|tests/test_docs_integrity.py|\
    tests/test_readme_docs_gate.py) return 0 ;;
  esac
  return 1
}

path_is_validation_input() {
  path_is_docs_source "$1" && return 0
  path_is_generated_doc "$1" && return 0
  path_is_instruction_source "$1" && return 0
  case "$1" in src/okto_neuron/*|pyproject.toml|uv.lock) return 0 ;; esac
  return 1
}

print_paths() {
  local path
  for path in "$@"; do
    printf '  • %q\n' "$path"
  done
}

package_init_is_version_only_change() {
  local before after before_count after_count before_normalized after_normalized
  before="$(git show HEAD:src/okto_neuron/__init__.py 2>/dev/null)" || return 1
  after="$(git show :src/okto_neuron/__init__.py 2>/dev/null)" || return 1
  before_count="$(printf '%s\n' "$before" | grep -Ec '^__version__ = "[^"]+"$' || true)"
  after_count="$(printf '%s\n' "$after" | grep -Ec '^__version__ = "[^"]+"$' || true)"
  [ "$before_count" = 1 ] && [ "$after_count" = 1 ] || return 1
  before_normalized="$(printf '%s\n' "$before" \
    | sed -E 's/^__version__ = "[^"]+"$/__version__ = "<version>"/')"
  after_normalized="$(printf '%s\n' "$after" \
    | sed -E 's/^__version__ = "[^"]+"$/__version__ = "<version>"/')"
  [ "$before_normalized" = "$after_normalized" ]
}

version_inputs_changed=0
lock_inputs_changed=0
docs_source_changed=0
generated_docs_changed=0
instruction_source_changed=0
src_changed_paths=()

for path in "${staged_paths[@]}"; do
  case "$path" in
    pyproject.toml|src/okto_neuron/__init__.py) version_inputs_changed=1 ;;
  esac
  case "$path" in
    pyproject.toml|uv.lock) lock_inputs_changed=1 ;;
  esac
  if [[ "$path" == src/okto_neuron/* ]]; then
    if [ "$path" != src/okto_neuron/__init__.py ] \
      || ! package_init_is_version_only_change; then
      src_changed_paths+=("$path")
    fi
  fi
  path_is_docs_source "$path" && docs_source_changed=1
  path_is_generated_doc "$path" && generated_docs_changed=1
  path_is_instruction_source "$path" && instruction_source_changed=1
done

# ── version-consistency gate (ALWAYS on; release reliability) ───────────────
# pyproject.toml `version` and src/okto_neuron/__init__.py `__version__` MUST match.
# A mismatch is the #1 release defect.
# Bypass only with `git commit --no-verify`; release-artifact CI independently
# checks version agreement on release candidates.
if [ "$version_inputs_changed" -eq 1 ]; then
  pyproj_v="$(git show ":pyproject.toml" 2>/dev/null | grep -E '^version = ' | head -1 | sed -E 's/^version = "(.*)"/\1/')"
  init_v="$(git show ":src/okto_neuron/__init__.py" 2>/dev/null | grep -E '^__version__ = ' | head -1 | sed -E 's/^__version__ = "(.*)"/\1/')"
  if [ -z "$pyproj_v" ] || [ -z "$init_v" ] || [ "$pyproj_v" != "$init_v" ]; then
    {
      echo "🔒 Version gate (pre-commit): version files disagree."
      echo "  pyproject.toml          version     = $pyproj_v"
      echo "  src/okto_neuron/__init__ __version__ = $init_v"
      echo
      echo "Both must match before committing a bump."
      echo "Fix them to the same value and re-stage, then commit again."
      echo "  (To bypass intentionally: git commit --no-verify)"
    } >&2
    exit 1
  fi
fi

if [ "${#src_changed_paths[@]}" -gt 0 ] && [ "$docs_source_changed" -eq 0 ]; then
  {
    echo "🔒 Docs gate (pre-commit): source is landing with no docs source update."
    echo
    echo "Source staged:"
    print_paths "${src_changed_paths[@]}"
    echo
    echo "The live codebase is the source of truth; docs must mirror it."
    echo "Stage the docs update into THIS commit, then commit again:"
    echo "  • Run /sync-docs to re-derive + regenerate, or edit the relevant"
    echo "    durable source (root docs, docs/, or a subsystem README) and stage all"
    echo "    four generated HTML pages."
    echo
    echo "MARGINALIA_DOCS_GATE=off is not supported. --no-verify can skip this local"
    echo "hook, but GitHub Actions will report the pushed SHA and release work must"
    echo "wait for that exact run to pass."
  } >&2
  exit 1
fi

if [ "$docs_source_changed" -eq 0 ] && [ "$generated_docs_changed" -eq 0 ] \
  && [ "$instruction_source_changed" -eq 0 ] && [ "$lock_inputs_changed" -eq 0 ]; then
  exit 0
fi

# The generator and semantic tests read the working tree. Refuse a mixed
# staged/unstaged snapshot so a commit cannot be validated against content it
# does not contain. Production paths are included because the semantic suite
# derives current interface truth from them.
unstaged_validation_paths=()
while IFS= read -r -d '' path; do
  path_is_validation_input "$path" && unstaged_validation_paths+=("$path")
done < <(git diff --no-renames --name-only -z)
while IFS= read -r -d '' path; do
  path_is_validation_input "$path" && unstaged_validation_paths+=("$path")
done < <(git ls-files --others --exclude-standard -z)
if [ "${#unstaged_validation_paths[@]}" -gt 0 ]; then
  {
    echo "🔒 Docs gate (pre-commit): validation snapshot is only partially staged."
    echo
    echo "Stage or revert these validation inputs before committing:"
    print_paths "${unstaged_validation_paths[@]}"
  } >&2
  exit 1
fi

if ! command -v uv >/dev/null 2>&1; then
  echo "🔒 Docs gate (pre-commit): uv is required to verify the committed lockfile." >&2
  exit 1
fi
if ! uv lock --check; then
  echo "🔒 Docs gate (pre-commit): uv.lock does not match pyproject.toml." >&2
  exit 1
fi

if [ "$docs_source_changed" -eq 0 ] && [ "$generated_docs_changed" -eq 0 ] \
  && [ "$instruction_source_changed" -eq 0 ]; then
  exit 0
fi

if [ -x ".venv/bin/python" ]; then
  python_bin=".venv/bin/python"
elif [ -x ".venv/Scripts/python.exe" ]; then
  python_bin=".venv/Scripts/python.exe"
else
  python_bin="${PYTHON:-python3}"
fi

if ! "$python_bin" docs/build_knowledge_base.py; then
  {
    echo
    echo "🔒 Docs gate (pre-commit): generated docs refresh failed."
    echo "Run this locally, fix the error, and commit again:"
    echo "  $python_bin docs/build_knowledge_base.py"
  } >&2
  exit 1
fi

generated_pages=(
  docs/index.html
  docs/knowledge-base/index.html
  docs/rfc.html
  docs/roadmap.html
)
missing_generated=""
for generated in "${generated_pages[@]}"; do
  if ! git cat-file -e ":$generated" 2>/dev/null; then
    missing_generated="${missing_generated}${missing_generated:+\n}${generated}"
  fi
done
if [ -n "$missing_generated" ]; then
  {
    echo
    echo "🔒 Docs gate (pre-commit): generated pages must remain tracked in this commit."
    printf '%b\n' "$missing_generated" | sed 's/^/  • /'
  } >&2
  exit 1
fi

stale_generated="$(git diff --name-only -- "${generated_pages[@]}" || true)"
if [ -n "$stale_generated" ]; then
  {
    echo
    echo "🔒 Docs gate (pre-commit): generated docs are stale."
    echo "The docs generator changed these working-tree files:"
    printf '%s\n' "$stale_generated" | sed 's/^/  • /'
    echo
    echo "Stage the refreshed generated docs, then commit again:"
    echo "  git add docs/index.html docs/knowledge-base/index.html docs/rfc.html docs/roadmap.html"
  } >&2
  exit 1
fi

if ! "$python_bin" -m pytest -q tests/test_docs_integrity.py tests/test_readme_docs_gate.py; then
  {
    echo
    echo "🔒 Docs gate (pre-commit): documentation integrity checks failed."
    echo "Fix the reported registry, link, or semantic drift and re-stage."
  } >&2
  exit 1
fi
