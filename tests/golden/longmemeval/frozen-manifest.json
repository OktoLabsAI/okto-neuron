{
  "schema_version": "longmemeval-marginalia-diagnostic.v1",
  "adapter_version": "longmemeval-golden-adapter.v3",
  "status": {
    "gating": false,
    "purpose": "public_procurement_diagnostic",
    "score_claims_allowed": false
  },
  "benchmark": {
    "name": "LongMemEval",
    "paper_url": "https://arxiv.org/abs/2410.10813",
    "conference_paper_url": "https://proceedings.iclr.cc/paper_files/paper/2025/file/d813d324dbf0598bbdc9c8e79740ed01-Paper-Conference.pdf",
    "code": {
      "url": "https://github.com/xiaowu0162/LongMemEval",
      "revision": "9e0b455f4ef0e2ab8f2e582289761153549043fc"
    }
  },
  "dataset": {
    "repository": "xiaowu0162/longmemeval-cleaned",
    "url": "https://huggingface.co/datasets/xiaowu0162/longmemeval-cleaned",
    "revision": "98d7416c24c778c2fee6e6f3006e7a073259d48f",
    "file": "longmemeval_s_cleaned.json",
    "file_sha256": "d6f21ea9d60a0d56f34a05b609c79c88a451d2ae03597821ea3d5a9678c3a442",
    "file_size_bytes": 277383467,
    "split": "longmemeval_s_cleaned",
    "expected_instances": 500,
    "license": "MIT",
    "language": "en",
    "required_fields": [
      "question_id",
      "question_type",
      "question",
      "answer",
      "question_date",
      "haystack_session_ids",
      "haystack_dates",
      "haystack_sessions",
      "answer_session_ids"
    ]
  },
  "selection": {
    "algorithm": "stratified_sha256.v1",
    "seed": "marginalia-longmemeval-public-diagnostic-v1",
    "per_bucket": 5,
    "required_buckets": [
      "single-session-user",
      "single-session-assistant",
      "single-session-preference",
      "temporal-reasoning",
      "knowledge-update",
      "multi-session",
      "abstention"
    ],
    "materialization": "derive_from_pinned_revision_at_conversion"
  },
  "mapping": {
    "isolation": "one_question_per_golden_dataset_and_vault",
    "ingestion_unit": "timestamped_session_markdown",
    "ingested_session_identity": "opaque_ordinal_only",
    "duplicate_source_session_id_policy": "preserve_every_ordinal_occurrence",
    "empty_turn_policy": "preserve_empty_body_with_role_header",
    "ingested_turn_roles": ["user", "assistant"],
    "label_fields_ingested": false,
    "query_field": "question",
    "query_rendering": "current_date_then_question.v1",
    "expected_answer_field": "answer",
    "session_reference_field": "answer_session_ids",
    "turn_reference_field": "haystack_sessions[].has_answer",
    "abstention_rule": "question_id_suffix__abs",
    "temporal_reasoning_evaluation": "retrieval_only_valid_time_qa_unsupported"
  },
  "runtime_placeholders": {
    "marginalia_revision": "UNSET",
    "llm_provider": "UNSET",
    "llm_model": "UNSET",
    "embedder_provider": "UNSET",
    "embedder_model": "UNSET",
    "judge_provider": "UNSET",
    "judge_model": "UNSET"
  },
  "baselines": {
    "upstream_plain_retrieval_reference": {
      "implementation": "flat-bm25",
      "granularity": "session",
      "indexed_roles": ["user"],
      "query_field": "question",
      "k_values": [1, 3, 5, 10, 30],
      "abstention_retrieval_policy": "exclude_no_ground_truth_location",
      "comparability": "reference_only_until_run_with_pinned_upstream_code"
    },
    "marginalia_plain_retrieval": {
      "surface": "/api/v1/recall",
      "answer_generation": false,
      "query_expansion": false,
      "reranking": false,
      "subgraph_expansion": false,
      "k_values": [1, 3, 5, 10, 30]
    },
    "marginalia_plain_rag": {
      "surface": "/api/v1/ask",
      "retrieval": "marginalia_plain_retrieval",
      "reader_model": "runtime_placeholders.llm_model",
      "judge_model": "runtime_placeholders.judge_model",
      "reading_strategy": "direct",
      "max_generation_tokens": "UNSET"
    }
  },
  "reporting": {
    "implemented_marginalia_retrieval_metrics": [
      "gold_span_retrieved_at_k",
      "gold_span_intact",
      "mean_byte_iou",
      "mean_token_recall"
    ],
    "upstream_session_reference_metrics": ["recall_any_at_k", "recall_all_at_k", "ndcg_at_k"],
    "pending_comparability_work": ["pinned_upstream_baseline_run"],
    "qa_metric": "reference_guided_judge_accuracy",
    "latency_metrics": ["retrieval_p50_ms", "retrieval_p95_ms", "qa_p50_ms", "qa_p95_ms"],
    "construction_cost_metrics": ["embedding_calls", "completion_calls", "input_tokens", "output_tokens"],
    "required_disclosures": [
      "selected_question_ids_sha256",
      "source_file_sha256",
      "marginalia_revision",
      "provider_and_model_ids",
      "prompt_or_policy_fingerprint",
      "failures_and_exclusions"
    ]
  },
  "privacy_and_license": {
    "derived_content_commit_allowed": false,
    "artifact_handling": "local_ephemeral_or_access_controlled",
    "source_license": "MIT dataset release; preserve upstream attribution",
    "privacy_note": "Treat conversational content as sensitive despite the upstream human screening; never send it to an unapproved provider.",
    "result_claim": "Diagnostic evidence only; not a LongMemEval leaderboard submission and not an ADR 0040 gate."
  }
}
