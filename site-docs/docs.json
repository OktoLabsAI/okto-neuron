{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Okto Neuron Documentation",
  "description": "Okto Neuron, a local-first knowledge vault. Your markdown stays the trust root; the graph is derived, byte-anchored and disposable. Prerelease (0.3.0).",
  "colors": {
    "primary": "#f5b942",
    "light": "#ffd166",
    "dark": "#c98a12"
  },
  "font": {
    "headings": {
      "family": "IBM Plex Sans",
      "weight": 600
    },
    "body": {
      "family": "IBM Plex Sans"
    }
  },
  "head": [
    {
      "tag": "link",
      "attributes": {
        "rel": "preconnect",
        "href": "https://fonts.googleapis.com"
      }
    },
    {
      "tag": "link",
      "attributes": {
        "rel": "preconnect",
        "href": "https://fonts.gstatic.com",
        "crossorigin": ""
      }
    },
    {
      "tag": "link",
      "attributes": {
        "rel": "stylesheet",
        "href": "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@300;400;500&family=IBM+Plex+Sans:wght@300;400;500;600;700&display=swap"
      }
    }
  ],
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/OktoLabsAI/okto-neuron"
      },
      {
        "label": "Issues",
        "href": "https://github.com/OktoLabsAI/okto-neuron/issues"
      }
    ]
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:site_name": "Okto Neuron Docs",
      "twitter:card": "summary_large_image"
    }
  },
  "metadata": {
    "timestamp": true
  },
  "search": {
    "prompt": "Search Okto Neuron docs..."
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "start/what-is-okto-neuron",
              "start/install",
              "start/prerelease-status",
              "start/first-run",
              "start/first-questions",
              "start/query-vs-ask",
              "start/connect-claude-code"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/surfaces",
              "concepts/what-is-a-vault",
              "concepts/from-file-to-graph",
              "concepts/data-model",
              "concepts/provenance",
              "concepts/supersession",
              "concepts/predicates",
              "concepts/subgraph-answers",
              "concepts/graph-lifecycle",
              "concepts/thin-client"
            ]
          },
          {
            "group": "The server",
            "pages": [
